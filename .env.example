# Obrigatória em produção (DEBUG=false); a app não arranca sem ela
SECRET_KEY=django-insecure-change-me-in-production
# Por omissão é false — usar true apenas em desenvolvimento local
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=firedb
DB_USER=fireuser
DB_PASSWORD=firepass
DB_HOST=localhost
DB_PORT=5432

# Opcional: S3 / Cloudflare R2 para media files
# AWS_STORAGE_BUCKET_NAME=fogobom-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=eu-west-1
# AWS_S3_ENDPOINT_URL=  # apenas para R2
# AWS_S3_CUSTOM_DOMAIN= # domínio público do bucket (opcional; sem ele usam-se URLs assinados)
